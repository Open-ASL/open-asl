# Copy to apps/web/.env.production to point production builds at a real Firebase project.
# Leave unset to use the local emulators (pnpm dev).
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
# Google sign-in needs no extra variables: enable the provider in the Firebase console.
# Firebase Storage base URL for the VASL art in production builds
VITE_ASSET_BASE=
# This deployment's public address, and where players reach its admins (apps/web/src/siteConfig.ts). Optional.
VITE_SITE_URL=
VITE_SUPPORT_URL=
VITE_SUPPORT_NAME=

# Dev server only (apps/web/.env.development.local): extra host names it answers to behind a reverse proxy.
# VITE_DEV_ALLOWED_HOSTS=.example.net
