{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null && auth.token.member == true",
      "$uid": {
        "$connectionId": {
          ".write": "auth != null && auth.token.member == true && auth.uid == $uid",
          ".validate": "newData.hasChildren(['at', 'area']) && newData.child('at').isNumber() && (newData.child('area').val() == 'lobby' || newData.child('area').val() == 'match') && (!newData.hasChild('active') || newData.child('active').isBoolean())"
        }
      }
    }
  }
}
